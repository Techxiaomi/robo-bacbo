# ==============================================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA APENAS NA SUA MÁQUINA.
# O .env REAL É IGNORADO PELO GIT E NUNCA DEVE SER COMMITADO.
# ==============================================================

# MySQL usado pelo backend Node.js
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Login / navegação do executor Playwright
CASINO_USER=
CASINO_PASSWORD=
CASINO_HOME_URL=https://example.invalid/
CASINO_GAME_URL=https://example.invalid/game
SESSION_STATE_FILE=

# Sincronização do saldo real exibido pela página
# Informe um seletor CSS específico do elemento que exibe o saldo da conta.
# Sem este seletor, a sincronização fica desativada e nenhum saldo é inferido.
CASINO_BALANCE_SELECTOR=
BALANCE_SYNC_INTERVAL_SECONDS=2
BALANCE_SYNC_HEARTBEAT_SECONDS=60
# O Node considera o saldo apto para novo baseline somente dentro desta janela.
# Mantenha este valor acima do heartbeat configurado no executor.
BALANCE_SYNC_MAX_AGE_SECONDS=90

# Comunicação interna Node <-> Python
# Gere um segredo longo e aleatorio (ex.: 32+ bytes) e use o MESMO valor nos dois processos.
INTERNAL_API_TOKEN=

# Journal local de idempotência do executor.
# Vazio usa robo-sync-pilot/runtime/executor_order_ids.json.
# O executor persiste o order_id antes de enfileirar a ordem e falha fechado se o journal estiver corrompido/indisponível.
EXECUTOR_ORDER_JOURNAL_FILE=
# Nova ordem só é aceita quando o Playwright está conectado/pronto; depois do aceite ela deve começar em até este TTL.
EXECUTOR_ORDER_TTL_SECONDS=8
# Deduplicação defensiva de frames Resolved sem roundId explícito.
RESULT_DEDUP_WINDOW_SECONDS=3
# O Node aguarda este tempo total pelo callback EXECUTADA/FALHOU/EXPIRADA/AMBIGUA do executor.
EXECUTOR_EXECUTION_TIMEOUT_MS=20000

# Autenticacao administrativa do painel.
# Em loopback, deixar usuario e senha vazios preserva o modo local sem login.
# Fora do loopback, ADMIN_USERNAME e ADMIN_PASSWORD tornam-se obrigatorios e o Node falha fechado se faltarem.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MINUTES=720
# Vazio = Secure automatico fora do loopback; use false somente em HTTP de rede local confiavel.
ADMIN_COOKIE_SECURE=

# Logging estruturado local do backend Node.
# JSONL rotativo em logs/backend.jsonl; segredos conhecidos são mascarados antes da gravação.
LOG_FILE_ENABLED=true
LOG_DIR=logs
LOG_FILE_NAME=backend.jsonl
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=3

# Metricas runtime do backend Node.
# Snapshot JSON atomico com uptime, memoria, event-loop, contagem de logs e falhas dos sinks.
METRICS_ENABLED=true
# Vazio reutiliza LOG_DIR (ou logs/ quando LOG_DIR também estiver vazio).
METRICS_DIR=
METRICS_FILE_NAME=backend.metrics.json
METRICS_INTERVAL_SECONDS=15

# Metricas operacionais HTTP do backend Node.
# Snapshot separado, sem payloads/URLs sensiveis: status e latencia por rota normalizada,
# chamadas outbound classificadas (executor/telegram/other) e freshness de resultado/saldo.
OPERATIONS_METRICS_ENABLED=true
# Vazio reutiliza METRICS_DIR, depois LOG_DIR, depois logs/.
OPERATIONS_METRICS_DIR=
OPERATIONS_METRICS_FILE_NAME=backend.operations.json
OPERATIONS_METRICS_INTERVAL_SECONDS=15
OPERATIONS_METRICS_MAX_SAMPLES=2048
OPERATIONS_METRICS_MAX_ROUTES=64

# Interface do painel/API Node. Mantenha 127.0.0.1 salvo necessidade explicita de acesso em rede.
NODE_HOST=127.0.0.1
NODE_PORT=3000
NODE_WEBHOOK_URL=http://127.0.0.1:3000/receber-sinal
NODE_EXECUTOR_STATUS_URL=http://127.0.0.1:3000/executor-status
EXECUTOR_URL=http://127.0.0.1:5000/apostar
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=5000
