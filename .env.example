# ==============================================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA APENAS NA SUA MÁQUINA.
# O .env REAL É IGNORADO PELO GIT E NUNCA DEVE SER COMMITADO.
# ==============================================================

# MySQL usado pelo backend Node.js
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Login / navegação do executor Playwright
CASINO_USER=
CASINO_PASSWORD=
CASINO_HOME_URL=https://example.invalid/
CASINO_GAME_URL=https://example.invalid/game
SESSION_STATE_FILE=

# Sincronização do saldo real exibido pela página
# Informe um seletor CSS específico do elemento que exibe o saldo da conta.
# Sem este seletor, a sincronização fica desativada e nenhum saldo é inferido.
CASINO_BALANCE_SELECTOR=
BALANCE_SYNC_INTERVAL_SECONDS=2
BALANCE_SYNC_HEARTBEAT_SECONDS=60
# O Node considera o saldo apto para novo baseline somente dentro desta janela.
# Mantenha este valor acima do heartbeat configurado no executor.
BALANCE_SYNC_MAX_AGE_SECONDS=90

# Comunicação interna Node <-> Python
# Gere um segredo longo e aleatorio (ex.: 32+ bytes) e use o MESMO valor nos dois processos.
INTERNAL_API_TOKEN=
NODE_PORT=3000
NODE_WEBHOOK_URL=http://127.0.0.1:3000/receber-sinal
EXECUTOR_URL=http://127.0.0.1:5000/apostar
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=5000
